# Copy this file to .env and adjust values for your environment.
# .env is git-ignored and must never be committed. Every value below is a placeholder - replace
# all of them (especially secrets) before use.
#
# This file covers *local development* (read by docker-compose and, via backend/app/core/config.py,
# by the backend running natively). It is NOT read in production - Render/Vercel/Neon/Cloudflare R2
# are configured with their own environment variables instead (see README.md's "Production
# deployment" section for the exact list per platform).

# --- PostgreSQL (local dev only - production uses DATABASE_URL, set directly on Render) ---
POSTGRES_DB=jats
POSTGRES_USER=jats
POSTGRES_PASSWORD=change-me

# --- Redis ---
# No credentials needed for local dev container.

# --- MinIO (S3-compatible storage, local dev only - production uses Cloudflare R2, see below) ---
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=resumes
# Browser-reachable MinIO URL, embedded in presigned upload URLs and public file URLs.
# Only needs to differ from the backend's internal S3_ENDPOINT when running the backend in Docker.
S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- Backend JWT ---
# Must be at least 32 characters for HS256. Generate a strong random value in production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-secret-in-production-min-32-chars
JWT_EXPIRATION_MS=86400000

# --- Default manager account (seeded on first startup if no manager exists) ---
MANAGER_DEFAULT_EMAIL=manager@example.com
MANAGER_DEFAULT_PASSWORD=change-me

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api

# =============================================================================
# Production-only variables (set these on Render/Vercel directly - never in a
# committed .env file). Listed here so every variable the app supports is
# documented in one place; see README.md for the full deployment guide.
# =============================================================================

# --- Backend on Render: database (Neon) ---
# Full connection string from the Neon dashboard, e.g.:
#   postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
# Takes priority over POSTGRES_* above when set - leave unset for local dev.
# DATABASE_URL=

# --- Backend on Render: object storage (Cloudflare R2) ---
# R2's S3 API endpoint: https://<account_id>.r2.cloudflarestorage.com
# S3_ENDPOINT=
# S3_PUBLIC_ENDPOINT=
# R2 access key/secret from an R2 API token (Cloudflare dashboard -> R2 -> Manage API Tokens).
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# R2 has no regions - Cloudflare's own client libraries use the literal string "auto".
# S3_REGION=auto
# Public read URL for objects - R2's public "r2.dev" bucket URL or a custom domain bound to the
# bucket (NOT the S3 API endpoint above, which requires auth for GET). No bucket segment in the
# path - the domain is already bound to one specific bucket. e.g.:
#   https://pub-xxxxxxxxxxxxxxxx.r2.dev
# S3_PUBLIC_URL=

# --- Backend on Render: CORS ---
# The deployed Vercel frontend's exact origin (scheme + host, no trailing slash/path). Comma-
# separate multiple origins (e.g. a custom domain alongside the vercel.app one).
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# --- Frontend on Vercel ---
# The deployed Render backend's base URL, including /api.
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
